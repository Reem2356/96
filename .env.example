# انسخ هذا الملف إلى .env.local واملأ إما قسم Firebase أو قسم Supabase
# (وليس الاثنين معًا - الأولوية دائمًا لـ Firebase إن كانت قيمه موجودة).
# بدون أي منهما، يعمل الموقع تلقائيًا بوضع البيانات التجريبية (Mock).

# --- Firebase (راجع firebase/README.md) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Supabase (راجع supabase/README.md) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# كلمة مرور لوحة الإدارة في وضع التطوير التجريبي فقط (بدون Firebase/Supabase).
# غير مستخدمة إطلاقًا عند تفعيل مصادقة حقيقية.
VITE_ADMIN_MOCK_PASSWORD=watan2026
